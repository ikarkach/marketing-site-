{{- /* Страницы моделей каталога: /projects/<страница>/<slug>/ — по одной на каждую серию.
       Кондиционеры: data/catalog.json; вентиляция и осушители Royal Clima (+Hisense): data/climate.json (scripts/build_royalclima.py).
       Названия, адреса и тексты берутся из data/models.toml, таблицы и цены — из данных (шаблон layouts/projects/model.html).
       Если у серии нет записи в models.toml, страница не создаётся. */ -}}
{{- $pageWeight := dict "hisense-nastennye" 10 "promyshlennye" 11 "hisense-multi-split" 12 "hisense-mobilnye" 13 "lg" 20 "ventilyaciya/brizery" 40 "ventilyaciya/pritochnye" 41 "ventilyaciya/rekuperatory" 42 "osushiteli/bytovye" 50 "osushiteli/dlya-basseynov" 51 -}}
{{- $all := merge hugo.Data.catalog.pages hugo.Data.climate.pages -}}
{{- range $page, $secs := $all }}
  {{- $meta := index hugo.Data.models $page }}
  {{- $category := "Кондиционеры" }}
  {{- $categoryUrl := "/projects/kondicionery/" }}
  {{- if hasPrefix $page "ventilyaciya" }}{{ $category = "Вентиляция" }}{{ $categoryUrl = "/projects/ventilyaciya/" }}{{ end }}
  {{- if hasPrefix $page "osushiteli" }}{{ $category = "Осушители и увлажнители" }}{{ $categoryUrl = "/projects/osushiteli/" }}{{ end }}
  {{- range $i, $sec := $secs }}
    {{- with index $meta $sec.id }}
      {{- $m := . }}
      {{- $.AddPage (dict
          "path" (printf "%s/%s" $page $m.slug)
          "kind" "page"
          "layout" "model"
          "title" $m.name
          "description" $m.description
          "weight" (add (mul (index $pageWeight $page | default 60) 100) $i)
          "params" (dict
              "seoTitle" $m.seoTitle
              "h1" $m.h1
              "page" $page
              "sid" $sec.id
              "parentPage" (printf "/projects/%s" $page)
              "category" $category
              "categoryUrl" $categoryUrl
          )
      ) }}
    {{- end }}
  {{- end }}
{{- end }}
